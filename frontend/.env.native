# Native shell environment configuration (Tauri / Capacitor)
# This file is ONLY loaded when running Vite with `--mode native` (e.g. `npm run build:native`).
# Plain web builds (`npm run build` used by Vercel) ignore this file and use relative `/api/v1` routes.
VITE_API_BASE_URL=https://eco-logix.vercel.app/api/v1
